{
  "name": "finguin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run build:charts && bun scripts/dev.ts",
    "build": "bun run build:charts && tsc --noEmit && vite build",
    "typecheck": "bun run build:charts && tsc --noEmit",
    "check": "biome check .",
    "test": "bun test",
    "build:charts": "tsc -p vendor/bklit/tsconfig.json",
    "import": "bun scripts/import.ts",
    "check:privacy": "bun scripts/check-privacy.ts",
    "setup:git": "git config core.hooksPath .githooks",
    "build:demo": "bun run build:charts && tsc --noEmit && vite build --mode demo --outDir dist/demo",
    "preview:demo": "vite preview --mode demo --outDir dist/demo --host 127.0.0.1 --port 5188 --strictPort"
  },
  "dependencies": {
    "@finguin/bklit": "workspace:*",
    "@fontsource-variable/inter": "5.3.0",
    "@heroicons/react": "2.2.0",
    "@tailwindcss/vite": "4.3.5",
    "clsx": "2.1.1",
    "d3-array": "3.2.5",
    "d3-scale": "4.0.3",
    "d3-shape": "3.2.1",
    "motion": "14.11.1",
    "papaparse": "5.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "simple-icons": "16.37.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/bun": "1.4.4",
    "@types/d3-array": "3.2.2",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  },
  "workspaces": [
    "vendor/bklit"
  ]
}
